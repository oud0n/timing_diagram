{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tickwave",
  "version": "1.0.0",
  "identifier": "com.oud0n.tickwave",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Tickwave", "width": 1280, "height": 850, "minWidth": 640, "minHeight": 480, "visible": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Create and edit SVG timing diagrams",
    "category": "DeveloperTool",
    "macOS": { "signingIdentity": "-" }
  }
}
