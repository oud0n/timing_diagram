{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-editor",
  "description": "Local editor window events, close handling and opening the support page",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://buymeacoffee.com/oud0n"
        },
        {
          "url": "https://github.com/oud0n/timing_diagram"
        }
      ]
    }
  ]
}
